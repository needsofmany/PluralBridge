<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0c5e5be9-ad3c-4c2c-a7fb-5eef146bda38</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);DEBUG_MODE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <BrowserAppSourceDir>$(MSBuildProjectDirectory)\..\..\..\app\src</BrowserAppSourceDir>
    <BrowserAppServeDir>$(MSBuildProjectDirectory)\wwwroot\app</BrowserAppServeDir>
  </PropertyGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="$(BrowserAppSourceDir)\index.html" Set="BrowserAppSync" />
    <UpToDateCheckInput Include="$(BrowserAppSourceDir)\js\**\*.js" Set="BrowserAppSync" />
    <UpToDateCheckInput Include="$(BrowserAppSourceDir)\css\**\*.css" Set="BrowserAppSync" />
    <UpToDateCheckInput Include="$(BrowserAppSourceDir)\assets\**\*" Set="BrowserAppSync"
                        Condition="Exists('$(BrowserAppSourceDir)\assets')" />

    <UpToDateCheckOutput Include="$(BrowserAppServeDir)\index.html" Set="BrowserAppSync" />
    <UpToDateCheckOutput Include="$(BrowserAppServeDir)\app.js" Set="BrowserAppSync" />
    <UpToDateCheckOutput Include="$(BrowserAppServeDir)\app.css" Set="BrowserAppSync" />
    <UpToDateCheckOutput Include="$(BrowserAppServeDir)\js\**\*.js" Set="BrowserAppSync" />
    <UpToDateCheckOutput Include="$(BrowserAppServeDir)\css\**\*.css" Set="BrowserAppSync" />
    <UpToDateCheckOutput Include="$(BrowserAppServeDir)\assets\**\*" Set="BrowserAppSync"
                         Condition="Exists('$(BrowserAppServeDir)\assets')" />
  </ItemGroup>

  <ItemGroup>
    <BrowserAppRootFile Include="$(BrowserAppSourceDir)\index.html">
      <ServePath>$(BrowserAppServeDir)\index.html</ServePath>
    </BrowserAppRootFile>
    <BrowserAppRootFile Include="$(BrowserAppSourceDir)\js\app.js">
      <ServePath>$(BrowserAppServeDir)\app.js</ServePath>
    </BrowserAppRootFile>
    <BrowserAppRootFile Include="$(BrowserAppSourceDir)\css\app.css">
      <ServePath>$(BrowserAppServeDir)\app.css</ServePath>
    </BrowserAppRootFile>

    <BrowserAppSourceJs Include="$(BrowserAppSourceDir)\js\**\*.js"
                        Exclude="$(BrowserAppSourceDir)\js\app.js">
      <ServePath>$(BrowserAppServeDir)\js\%(RecursiveDir)%(Filename)%(Extension)</ServePath>
    </BrowserAppSourceJs>

    <BrowserAppSourceCss Include="$(BrowserAppSourceDir)\css\**\*.css"
                         Exclude="$(BrowserAppSourceDir)\css\app.css">
      <ServePath>$(BrowserAppServeDir)\css\%(RecursiveDir)%(Filename)%(Extension)</ServePath>
    </BrowserAppSourceCss>

    <BrowserAppSourceAssets Include="$(BrowserAppSourceDir)\assets\**\*"
                            Condition="Exists('$(BrowserAppSourceDir)\assets')">
      <ServePath>$(BrowserAppServeDir)\assets\%(RecursiveDir)%(Filename)%(Extension)</ServePath>
    </BrowserAppSourceAssets>
  </ItemGroup>

  <Target Name="PrepareBrowserAppSync">
    <Error Condition="!Exists('$(BrowserAppSourceDir)\index.html')"
           Text="Browser app source is missing: $(BrowserAppSourceDir)\index.html" />
    <Error Condition="!Exists('$(BrowserAppSourceDir)\js\app.js')"
           Text="Browser app source is missing: $(BrowserAppSourceDir)\js\app.js" />
    <Error Condition="!Exists('$(BrowserAppSourceDir)\css\app.css')"
           Text="Browser app source is missing: $(BrowserAppSourceDir)\css\app.css" />

    <MakeDir Directories="$(BrowserAppServeDir);$(BrowserAppServeDir)\js;$(BrowserAppServeDir)\css" />
    <MakeDir Directories="$(BrowserAppServeDir)\assets" Condition="Exists('$(BrowserAppSourceDir)\assets')" />
  </Target>

  <Target Name="SyncBrowserAppRootFiles"
          DependsOnTargets="PrepareBrowserAppSync"
          Inputs="%(BrowserAppRootFile.Identity)"
          Outputs="%(BrowserAppRootFile.ServePath)">
    <Copy SourceFiles="%(BrowserAppRootFile.Identity)"
          DestinationFiles="%(BrowserAppRootFile.ServePath)" />
    <Message Importance="high"
             Text="copied '%(BrowserAppRootFile.Identity)' to '%(BrowserAppRootFile.ServePath)'" />
  </Target>

  <Target Name="SyncBrowserAppJsFiles"
          DependsOnTargets="PrepareBrowserAppSync"
          Inputs="%(BrowserAppSourceJs.Identity)"
          Outputs="%(BrowserAppSourceJs.ServePath)">
    <Copy SourceFiles="%(BrowserAppSourceJs.Identity)"
          DestinationFiles="%(BrowserAppSourceJs.ServePath)" />
    <Message Importance="high"
             Text="copied '%(BrowserAppSourceJs.Identity)' to '%(BrowserAppSourceJs.ServePath)'" />
  </Target>

  <Target Name="SyncBrowserAppCssFiles"
          DependsOnTargets="PrepareBrowserAppSync"
          Inputs="%(BrowserAppSourceCss.Identity)"
          Outputs="%(BrowserAppSourceCss.ServePath)">
    <Copy SourceFiles="%(BrowserAppSourceCss.Identity)"
          DestinationFiles="%(BrowserAppSourceCss.ServePath)" />
    <Message Importance="high"
             Text="copied '%(BrowserAppSourceCss.Identity)' to '%(BrowserAppSourceCss.ServePath)'" />
  </Target>

  <Target Name="SyncBrowserAppAssetFiles"
          DependsOnTargets="PrepareBrowserAppSync"
          Inputs="%(BrowserAppSourceAssets.Identity)"
          Outputs="%(BrowserAppSourceAssets.ServePath)"
          Condition="'@(BrowserAppSourceAssets)' != ''">
    <Copy SourceFiles="%(BrowserAppSourceAssets.Identity)"
          DestinationFiles="%(BrowserAppSourceAssets.ServePath)" />
    <Message Importance="high"
             Text="copied '%(BrowserAppSourceAssets.Identity)' to '%(BrowserAppSourceAssets.ServePath)'" />
  </Target>

  <Target Name="SyncBrowserAppArtifacts"
          BeforeTargets="Build;Publish"
          DependsOnTargets="SyncBrowserAppRootFiles;SyncBrowserAppJsFiles;SyncBrowserAppCssFiles;SyncBrowserAppAssetFiles" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	<PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Account\Service\" />
  </ItemGroup>

<PropertyGroup>
  <FrontendSyncScriptBash>$(MSBuildProjectDirectory)/../../../app/scripts/sync-browser-app.sh</FrontendSyncScriptBash>
  <FrontendSyncScriptPowerShell>$(MSBuildProjectDirectory)/../../../app/scripts/sync-browser-app.ps1</FrontendSyncScriptPowerShell>
</PropertyGroup>

<Target Name="SyncBrowserApp" BeforeTargets="Build;Publish">
  <Message Importance="high" Text="Running frontend sync (Windows): $(FrontendSyncScriptPowerShell)" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  <Message Importance="high" Text="Running frontend sync (Unix): $(FrontendSyncScriptBash)" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />

  <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(FrontendSyncScriptPowerShell)"'
        Condition="$([MSBuild]::IsOSPlatform('Windows'))" />

  <Exec Command='bash "$(FrontendSyncScriptBash)"'
        Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
</Target>



  <PropertyGroup>
    <FrontendSyncCheckScriptBash>$(MSBuildProjectDirectory)/../../../app/scripts/check-browser-sync.sh</FrontendSyncCheckScriptBash>
    <FrontendSyncCheckScriptPowerShell>$(MSBuildProjectDirectory)/../../../app/scripts/check-browser-sync.ps1</FrontendSyncCheckScriptPowerShell>
  </PropertyGroup>

  <Target Name="VerifyBrowserAppSync" BeforeTargets="Build;Publish" DependsOnTargets="SyncBrowserApp">
    <Message Importance="high" Text="Verifying frontend sync (Windows): $(FrontendSyncCheckScriptPowerShell)" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Message Importance="high" Text="Verifying frontend sync (Unix): $(FrontendSyncCheckScriptBash)" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(FrontendSyncCheckScriptPowerShell)"'
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command='bash "$(FrontendSyncCheckScriptBash)"'
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <PropertyGroup>
    <FrontendAllowlistCheckScriptBash>$(MSBuildProjectDirectory)/../../../app/scripts/check-browser-allowlists.sh</FrontendAllowlistCheckScriptBash>
    <FrontendAllowlistCheckScriptPowerShell>$(MSBuildProjectDirectory)/../../../app/scripts/check-browser-allowlists.ps1</FrontendAllowlistCheckScriptPowerShell>
  </PropertyGroup>

  <Target Name="VerifyBrowserAllowlists" BeforeTargets="Build;Publish" DependsOnTargets="VerifyBrowserAppSync">
    <Message Importance="high" Text="Verifying frontend allowlists (Windows): $(FrontendAllowlistCheckScriptPowerShell)" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Message Importance="high" Text="Verifying frontend allowlists (Unix): $(FrontendAllowlistCheckScriptBash)" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(FrontendAllowlistCheckScriptPowerShell)"'
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command='bash "$(FrontendAllowlistCheckScriptBash)"'
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

</Project>
